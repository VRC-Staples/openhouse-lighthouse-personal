foreach(component IN LISTS ZLIB_FIND_COMPONENTS)
    if(NOT component STREQUAL "static")
        set(ZLIB_FOUND FALSE)
        set(ZLIB_NOT_FOUND_MESSAGE "This zlib overlay provides only the static library")
        return()
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ZLIB-static.cmake")
set(ZLIB_static_FOUND TRUE)
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS ZLIB::ZLIBSTATIC)
endif()
