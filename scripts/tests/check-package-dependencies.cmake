# Exercise the installed package's dependency selection without claiming a Linux link test.
cmake_minimum_required(VERSION 3.20)
set(root "${CMAKE_CURRENT_LIST_DIR}/../..")
set(out "${CMAKE_CURRENT_BINARY_DIR}/build-package-config-test")
file(MAKE_DIRECTORY "${out}")
file(WRITE "${out}/lighthouseTargets.cmake" "")
function(find_package name)
  list(APPEND requested "${name}")
  set(requested "${requested}" PARENT_SCOPE)
  set(${name}_FOUND TRUE PARENT_SCOPE)
endfunction()
function(pkg_check_modules prefix)
  if(NOT "${ARGV}" STREQUAL "UDEV;REQUIRED;IMPORTED_TARGET;libudev")
    message(FATAL_ERROR "Incorrect libudev dependency: ${ARGV}")
  endif()
  set(udev_checked TRUE PARENT_SCOPE)
endfunction()
macro(check_required_components name)
endmacro()
function(check_case platform LH_BUILD_USB)
  set(WIN32 FALSE)
  set(APPLE FALSE)
  if(platform STREQUAL "Windows")
    set(WIN32 TRUE)
  elseif(platform STREQUAL "Apple")
    set(APPLE TRUE)
  endif()
    set(requested "")
    set(udev_checked FALSE)
    configure_file("${root}/cmake/lighthouseConfig.cmake.in" "${out}/config.cmake" @ONLY)
    include("${out}/config.cmake")
    if(LH_BUILD_USB AND platform STREQUAL "Linux")
      if(NOT udev_checked OR NOT "PkgConfig" IN_LIST requested OR "hidapi" IN_LIST requested)
        message(FATAL_ERROR "Linux consumer dependencies are incomplete")
      endif()
    elseif(LH_BUILD_USB)
      if(NOT "hidapi" IN_LIST requested OR udev_checked)
        message(FATAL_ERROR "Native HID consumer dependencies are incomplete")
      endif()
    elseif("hidapi" IN_LIST requested OR "PkgConfig" IN_LIST requested OR udev_checked)
      message(FATAL_ERROR "USB-off consumers must not require USB dependencies")
    endif()
    message(STATUS "PASS: ${platform}, USB=${LH_BUILD_USB} dependency selection")
endfunction()
foreach(platform IN ITEMS Windows Apple Linux)
  foreach(usb IN ITEMS ON OFF)
    check_case("${platform}" "${usb}")
  endforeach()
endforeach()
file(REMOVE_RECURSE "${out}")
