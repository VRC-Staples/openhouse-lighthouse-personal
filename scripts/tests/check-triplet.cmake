foreach(PORT IN ITEMS openvr ceres)
  include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/triplets/x64-windows-static-release.cmake")
  if(PORT STREQUAL "openvr")
    set(expected dynamic)
  else()
    set(expected static)
  endif()
  if(NOT VCPKG_CRT_LINKAGE STREQUAL expected OR NOT VCPKG_LIBRARY_LINKAGE STREQUAL expected)
    message(FATAL_ERROR "Wrong CRT/library linkage for ${PORT}")
  endif()
endforeach()
message(STATUS "Triplet keeps OpenVR dynamic and tracking dependencies static")
