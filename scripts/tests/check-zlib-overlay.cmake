# Exercise the recipe's inputs and file transformations without running vcpkg or installing zlib.
cmake_minimum_required(VERSION 3.20)
set(root "${CMAKE_CURRENT_LIST_DIR}/../..")
set(port "${root}/cmake/ports/zlib")
set(out "${CMAKE_CURRENT_BINARY_DIR}/build-zlib-overlay-test")
file(READ "${root}/scripts/ci/toolchain-lock.json" lock)
string(JSON source_hash GET "${lock}" ports zlib source_sha512)
string(JSON source_url GET "${lock}" ports zlib source_url)

function(vcpkg_check_linkage linkage)
  if(NOT linkage STREQUAL "ONLY_STATIC_LIBRARY")
    message(FATAL_ERROR "The zlib overlay must retain static linkage")
  endif()
endfunction()
function(vcpkg_download_distfile result)
  cmake_parse_arguments(arg "" "FILENAME;SHA512" "URLS" ${ARGN})
  if(NOT arg_FILENAME STREQUAL "zlib-1.4.tar.gz" OR
     NOT arg_SHA512 STREQUAL source_hash OR NOT arg_URLS STREQUAL source_url)
    message(FATAL_ERROR "The recipe source does not match the locked archive")
  endif()
  set(${result} "${out}/source-archive-not-downloaded" PARENT_SCOPE)
endfunction()
function(vcpkg_extract_source_archive result)
  file(MAKE_DIRECTORY "${out}/source")
  file(WRITE "${out}/source/LICENSE" "Synthetic notice for recipe checks only\n")
  set(${result} "${out}/source" PARENT_SCOPE)
endfunction()
function(vcpkg_cmake_configure)
  foreach(required IN ITEMS -DZLIB_BUILD_TESTING=OFF -DZLIB_BUILD_SHARED=OFF
                            -DZLIB_BUILD_STATIC=ON -DZLIB_INSTALL=ON)
    if(NOT required IN_LIST ARGN)
      message(FATAL_ERROR "The recipe omitted ${required}")
    endif()
  endforeach()
endfunction()
function(vcpkg_cmake_install)
  file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/lib/pkgconfig"
    "${CURRENT_PACKAGES_DIR}/include" "${CURRENT_PACKAGES_DIR}/share/zlib")
  file(WRITE "${CURRENT_PACKAGES_DIR}/lib/pkgconfig/zlib.pc"
    "includedir=/prefix/include\nLibs: -L/prefix/lib -lz\n")
  file(WRITE "${CURRENT_PACKAGES_DIR}/include/zconf.h" "#ifdef ZLIB_DLL\n#endif\n")
  if(NOT VCPKG_BUILD_TYPE)
    file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/debug/lib/pkgconfig")
    file(WRITE "${CURRENT_PACKAGES_DIR}/debug/lib/pkgconfig/zlib.pc"
      "includedir=/prefix/include\nLibs: -L/prefix/debug/lib -lz\n")
  endif()
endfunction()
function(vcpkg_copy_pdbs)
endfunction()
function(vcpkg_cmake_config_fixup)
endfunction()
function(vcpkg_fixup_pkgconfig)
endfunction()
function(vcpkg_install_copyright)
  if(NOT EXISTS "${SOURCE_PATH}/LICENSE")
    message(FATAL_ERROR "The upstream license must be retained")
  endif()
endfunction()
function(vcpkg_replace_string path before after)
  file(READ "${path}" text)
  string(FIND "${text}" "${before}" index)
  if(index LESS 0)
    message(FATAL_ERROR "Missing expected recipe replacement: ${before}")
  endif()
  string(REPLACE "${before}" "${after}" text "${text}")
  file(WRITE "${path}" "${text}")
endfunction()

function(check_pc path library debug)
  file(READ "${path}" text)
  string(FIND "${text}" " -l${library}\n" index)
  if(index LESS 0)
    message(FATAL_ERROR "Incorrect pkg-config library in ${path}: ${text}")
  endif()
  if(debug AND NOT text MATCHES "/prefix/../include")
    message(FATAL_ERROR "The debug pkg-config include path was not corrected")
  endif()
endfunction()
function(check_case platform mode library debug_library)
  set(VCPKG_TARGET_IS_WINDOWS TRUE)
  set(VCPKG_TARGET_IS_MINGW FALSE)
  if(platform STREQUAL "MinGW")
    set(VCPKG_TARGET_IS_MINGW TRUE)
  elseif(platform STREQUAL "Linux")
    set(VCPKG_TARGET_IS_WINDOWS FALSE)
  endif()
  set(VCPKG_LIBRARY_LINKAGE static)
  set(VCPKG_BUILD_TYPE "")
  if(mode STREQUAL "Release")
    set(VCPKG_BUILD_TYPE release)
  endif()
  set(CURRENT_PACKAGES_DIR "${out}/${platform}-${mode}")
  include("${port}/portfile.cmake")
  check_pc("${CURRENT_PACKAGES_DIR}/lib/pkgconfig/zlib.pc" "${library}" FALSE)
  if(NOT VCPKG_BUILD_TYPE)
    check_pc("${CURRENT_PACKAGES_DIR}/debug/lib/pkgconfig/zlib.pc" "${debug_library}" TRUE)
  endif()
  file(READ "${CURRENT_PACKAGES_DIR}/include/zconf.h" header)
  if(NOT header MATCHES "#if 0")
    message(FATAL_ERROR "Static consumers must not use ZLIB_DLL")
  endif()
  foreach(name IN ITEMS ZLIBConfig.cmake vcpkg-cmake-wrapper.cmake)
    file(READ "${port}/${name}" expected)
    file(READ "${CURRENT_PACKAGES_DIR}/share/zlib/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "The recipe did not preserve ${name}")
    endif()
  endforeach()
  message(STATUS "PASS: ${platform} ${mode} zlib recipe (stubbed helpers, no installation)")
endfunction()
foreach(mode IN ITEMS Release Dual)
  check_case(MSVC "${mode}" libzs libzsd)
  check_case(MinGW "${mode}" zs zsd)
  check_case(Linux "${mode}" z z)
endforeach()
file(REMOVE_RECURSE "${out}")
